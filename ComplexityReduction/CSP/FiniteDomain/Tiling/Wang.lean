import Mathlib.Tactic
import ComplexityReduction.CSP.FiniteDomain.Tiling.Rectangular

/-!
Wang-tile edge-color compatibility for rectangular finite-domain tiling CSPs.

This module is a thin, theorem-bearing layer over `Tiling.Rectangular`.  A Wang
palette supplies a finite oriented tile palette together with a color on each
side of each tile state.  Rectangular nearest-neighbor checks are generated by
matching east/west colors horizontally and south/north colors vertically.
-/

namespace ComplexityReduction
namespace CSP
namespace FiniteDomain
namespace Tiling
namespace Wang

/-- Sides of an edge-colored Wang tile. -/
inductive Side where
  | north
  | east
  | south
  | west
  deriving DecidableEq, Fintype, Repr

/--
Finite edge-colored tile palette.  The underlying tile states are the existing
oriented tile states from `Tiling.TilePalette`; this descriptor only adds side
colors.
-/
structure EdgeColoredPalette (Color : Type) where
  palette : TilePalette
  color : Side → palette.State → Color

/-- Number of unoriented tile identifiers in a Wang palette. -/
def tileCount {Color : Type} (P : EdgeColoredPalette Color) : Nat :=
  P.palette.tileCount

/-- Number of orientations in a Wang palette. -/
def orientationCount {Color : Type} (P : EdgeColoredPalette Color) : Nat :=
  P.palette.orientationCount

/-- The finite CSP domain of tile states for a Wang palette. -/
abbrev State {Color : Type} (P : EdgeColoredPalette Color) : Type :=
  P.palette.State

/-- Color on one side of one tile state. -/
def color {Color : Type} (P : EdgeColoredPalette Color) (side : Side)
    (s : P.palette.State) : Color :=
  P.color side s

/-- The side of the first endpoint of an oriented rectangular neighbor pair. -/
def sourceSide : Direction → Side
  | Direction.horizontal => Side.east
  | Direction.vertical => Side.south

/-- The side of the second endpoint of an oriented rectangular neighbor pair. -/
def targetSide : Direction → Side
  | Direction.horizontal => Side.west
  | Direction.vertical => Side.north

/-- Two adjacent Wang tile states are compatible when their touching colors match. -/
def compatible {Color : Type} (P : EdgeColoredPalette Color) (dir : Direction)
    (s t : P.palette.State) : Prop :=
  color P (sourceSide dir) s = color P (targetSide dir) t

/-- Compatibility unfolds to equality of the two touching edge colors. -/
@[simp]
theorem compatible_iff_color_eq {Color : Type} (P : EdgeColoredPalette Color)
    (dir : Direction) (s t : P.palette.State) :
    compatible P dir s t ↔ color P (sourceSide dir) s = color P (targetSide dir) t :=
  Iff.rfl

/-- Wang tiles allow every palette state at every rectangular cell. -/
def allowedCell {Color : Type} (P : EdgeColoredPalette Color) :
    GridCell → P.palette.State → Prop :=
  fun _ _ => True

/-- Wang nearest-neighbor rule generated from edge-color compatibility. -/
def allowedAdj {Color : Type} (P : EdgeColoredPalette Color) :
    Direction → GridCell → GridCell → P.palette.State → P.palette.State → Prop :=
  fun dir _ _ s t => compatible P dir s t

/-- Horizontal Wang adjacency checks match east and west colors. -/
@[simp]
theorem allowedAdj_horizontal_iff {Color : Type} (P : EdgeColoredPalette Color)
    (c d : GridCell) (s t : P.palette.State) :
    allowedAdj P Direction.horizontal c d s t ↔
      color P Side.east s = color P Side.west t :=
  Iff.rfl

/-- Vertical Wang adjacency checks match south and north colors. -/
@[simp]
theorem allowedAdj_vertical_iff {Color : Type} (P : EdgeColoredPalette Color)
    (c d : GridCell) (s t : P.palette.State) :
    allowedAdj P Direction.vertical c d s t ↔
      color P Side.south s = color P Side.north t :=
  Iff.rfl

/-- Assignment-level rectangular Wang tiling predicate. -/
def Satisfies {Color : Type} (R : RectangularRegion) (P : EdgeColoredPalette Color)
    (a : Placement P.palette) : Prop :=
  Rectangular.Satisfies R P.palette (allowedCell P) (allowedAdj P) a

/-- A rectangular Wang instance is tileable when some placement satisfies all rules. -/
def Tileable {Color : Type} (R : RectangularRegion) (P : EdgeColoredPalette Color) :
    Prop :=
  ∃ a : Placement P.palette, Satisfies R P a

/-- Rectangular local-check instance generated by Wang edge-color rules. -/
def rectangularWangTilingInstance {Color : Type} (R : RectangularRegion)
    (P : EdgeColoredPalette Color) : TilingInstance P.palette :=
  Rectangular.rectangularTilingInstance R P.palette (allowedCell P) (allowedAdj P)

/-- Finite-domain CSP formula generated by rectangular Wang edge-color rules. -/
def rectangularWangTilingFormula {Color : Type} (R : RectangularRegion)
    (P : EdgeColoredPalette Color) :
    Formula (rectangularWangTilingInstance R P).language :=
  Rectangular.rectangularTilingFormula R P.palette (allowedCell P) (allowedAdj P)

/-- Formula satisfaction is exactly rectangular Wang local-rule satisfaction. -/
theorem rectangularWangTilingFormula_satisfies_iff {Color : Type}
    (R : RectangularRegion) (P : EdgeColoredPalette Color) (a : Placement P.palette) :
    Formula.Satisfies (rectangularWangTilingFormula R P) a ↔ Satisfies R P a := by
  simpa [rectangularWangTilingFormula, rectangularWangTilingInstance, Satisfies] using
    Rectangular.rectangularTilingFormula_satisfies_iff R P.palette (allowedCell P)
      (allowedAdj P) a

/-- Formula satisfiability is exactly rectangular Wang tileability. -/
theorem rectangularWangTilingFormula_satisfiable_iff {Color : Type}
    (R : RectangularRegion) (P : EdgeColoredPalette Color) :
    Formula.Satisfiable (rectangularWangTilingFormula R P) ↔ Tileable R P := by
  constructor
  · rintro ⟨a, hSat⟩
    exact ⟨a, (rectangularWangTilingFormula_satisfies_iff R P a).1 hSat⟩
  · rintro ⟨a, hSat⟩
    exact ⟨a, (rectangularWangTilingFormula_satisfies_iff R P a).2 hSat⟩

/-- Rectangular Wang formulas have coverage plus horizontal and vertical checks. -/
theorem rectangularWangTilingFormula_length_eq {Color : Type}
    (R : RectangularRegion) (P : EdgeColoredPalette Color) :
    (rectangularWangTilingFormula R P).length =
      R.cellCount + (R.height * (R.width - 1) + (R.height - 1) * R.width) := by
  simp [rectangularWangTilingFormula, rectangularWangTilingInstance]

/-- Every generated rectangular Wang local-check scope is below `R.cellCount`. -/
theorem localChecks_scope_lt_cellCount {Color : Type} {R : RectangularRegion}
    {P : EdgeColoredPalette Color} {C : LocalCheck P.palette.State}
    (hC : C ∈ (rectangularWangTilingInstance R P).checks) (i : Fin C.arity) :
    C.scope i < R.cellCount := by
  simpa [rectangularWangTilingInstance] using
    Rectangular.localChecks_scope_lt_cellCount (R := R) (P := P.palette)
      (allowedCell := allowedCell P) (allowedAdj := allowedAdj P) hC i

end Wang
end Tiling
end FiniteDomain
end CSP
end ComplexityReduction
