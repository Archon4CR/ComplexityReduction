import ComplexityReduction.CSP.FiniteDomain.Tiling.MooreRobson

/-!
Proof-carrying realization interface for Moore-Robson style Wang-tile gadgets.

The descriptor catalog records wire and gate truth tables.  This module adds a
small abstract wrapper for future concrete rectangular Wang gadgets: a
realization supplies a rectangular region, an edge-colored palette, a boundary
condition reading the gadget ports, and soundness/completeness with respect to a
truth table.  It does not encode the Moore-Robson palette or assert any global
tiling hardness theorem.
-/

namespace ComplexityReduction
namespace CSP
namespace FiniteDomain
namespace Tiling
namespace MooreRobson

/-- Signal assignment of a fixed arity. -/
abbrev SignalAssignment (n : Nat) : Type :=
  Fin n → Signal

/-- Values carried by the input and output ports of a local gadget. -/
structure PortValuation (inputArity outputArity : Nat) where
  inputs : SignalAssignment inputArity
  outputs : SignalAssignment outputArity

/--
Boundary predicate tying a signal valuation to a Wang placement.  Concrete
realizations decide how ports are encoded by tiles and edge colors.
-/
abbrev BoundaryCondition {Color : Type} (P : Wang.EdgeColoredPalette Color)
    (inputArity outputArity : Nat) : Type :=
  PortValuation inputArity outputArity → Placement P.palette → Prop

/-- Rectangular Wang region and palette used by one local Moore-Robson gadget. -/
structure WangGadgetRegion (Color : Type) where
  region : RectangularRegion
  palette : Wang.EdgeColoredPalette Color
  notes : List String := []

/--
A proof-carrying local Wang-gadget realization.

The fields are intentionally local: satisfiability of the generated rectangular
Wang formula, together with the supplied boundary predicate, is equivalent to
the descriptor-level truth table.
-/
structure WangGadgetRealization (Color : Type) (inputArity outputArity : Nat) where
  gadget : WangGadgetRegion Color
  boundaryCondition : BoundaryCondition gadget.palette inputArity outputArity
  truthTable : PortValuation inputArity outputArity → Prop
  complete :
    ∀ v, truthTable v →
      ∃ a : Placement gadget.palette.palette,
        Formula.Satisfies (Wang.rectangularWangTilingFormula gadget.region gadget.palette) a ∧
          boundaryCondition v a
  sound :
    ∀ v,
      (∃ a : Placement gadget.palette.palette,
        Formula.Satisfies (Wang.rectangularWangTilingFormula gadget.region gadget.palette) a ∧
          boundaryCondition v a) →
        truthTable v
  notes : List String := []

/-- The finite-domain formula generated by the rectangular Wang realization. -/
def realizationFormula {Color : Type} {inputArity outputArity : Nat}
    (G : WangGadgetRealization Color inputArity outputArity) :=
  Wang.rectangularWangTilingFormula G.gadget.region G.gadget.palette

/-- Formula satisfaction is exactly the rectangular Wang local-rule predicate. -/
theorem realizationFormula_satisfies_iff {Color : Type} {inputArity outputArity : Nat}
    (G : WangGadgetRealization Color inputArity outputArity)
    (a : Placement G.gadget.palette.palette) :
    Formula.Satisfies (realizationFormula G) a ↔
      Wang.Satisfies G.gadget.region G.gadget.palette a := by
  simpa [realizationFormula] using
    Wang.rectangularWangTilingFormula_satisfies_iff G.gadget.region G.gadget.palette a

/--
The proof-carrying realization exposes boundary-constrained satisfiability as
the supplied truth table.
-/
theorem realization_solutionEquiv_truthTable {Color : Type} {inputArity outputArity : Nat}
    (G : WangGadgetRealization Color inputArity outputArity)
    (v : PortValuation inputArity outputArity) :
    (∃ a : Placement G.gadget.palette.palette,
      Formula.Satisfies (realizationFormula G) a ∧ G.boundaryCondition v a) ↔
      G.truthTable v := by
  constructor
  · intro h
    exact G.sound v (by simpa [realizationFormula] using h)
  · intro h
    simpa [realizationFormula] using G.complete v h

/-- A realization has the truth table of a wire descriptor. -/
def realizesWireTruthTable {Color : Type} (W : WireDescriptor)
    (G : WangGadgetRealization Color 1 1) : Prop :=
  ∀ v : PortValuation 1 1, G.truthTable v ↔
    W.truthTable (v.inputs (0 : Fin 1)) (v.outputs (0 : Fin 1))

/-- A realization has the truth table of a gate descriptor. -/
def realizesGateTruthTable {Color : Type} (D : GateDescriptor)
    (G : WangGadgetRealization Color D.kind.inputArity D.kind.outputArity) : Prop :=
  ∀ v : PortValuation D.kind.inputArity D.kind.outputArity,
    G.truthTable v ↔ D.truthTable v.inputs v.outputs

end MooreRobson
end Tiling
end FiniteDomain
end CSP
end ComplexityReduction
