import ComplexityReduction.CSP.FiniteDomain.FiniteSupport
import ComplexityReduction.CSP.FiniteDomain.DerivedFamily

/-!
Automatic bounds for finite-domain pp-definition expansion.

`PPDef.formulaViaRepresentationFrom_complete` exposes the precise freshness and
block-width hypotheses needed by the recursive expansion compiler.  This module
packages the standard finite-support bounds so generated reductions can use a
single canonical expansion map.
-/

namespace ComplexityReduction
namespace CSP
namespace FiniteDomain
namespace PPDef

namespace RelationFormula

/-- A strict upper bound for variables mentioned by a pp block. -/
noncomputable def varBound {D : Type} {Γ : Language D} {arity : Nat}
    (rep : RelationFormula Γ arity) : Nat :=
  FiniteSupport.formulaVarBound rep.constraints

theorem var_lt_varBound {D : Type} {Γ : Language D} {arity : Nat}
    (rep : RelationFormula Γ arity) {x : Nat}
    (hx : x ∈ FiniteSupport.formulaVars rep.constraints) :
    x < rep.varBound :=
  FiniteSupport.var_lt_formulaVarBound hx

/-- Every scoped variable in a pp block is below `varBound`. -/
theorem constraint_var_lt_varBound_of_mem {D : Type} {Γ : Language D} {arity : Nat}
    (rep : RelationFormula Γ arity) {c : Constraint Γ} (hc : c ∈ rep.constraints)
    (i : Fin (Γ.relationOf c.symbol).arity) :
    c.vars i < rep.varBound :=
  rep.var_lt_varBound (FiniteSupport.var_mem_formulaVars_of_constraint_mem hc i)

/-- The local block-width side condition generated by `varBound`. -/
theorem blockBound {D : Type} {Γ : Language D} {arity : Nat}
    (rep : RelationFormula Γ arity) :
    ∀ c ∈ rep.constraints,
      ∀ i : Fin (Γ.relationOf c.symbol).arity, c.vars i < rep.varBound := by
  intro c hc i
  exact rep.constraint_var_lt_varBound_of_mem hc i

end RelationFormula

namespace LanguageRepresentation

/-- A strict upper bound for variables mentioned in one representation block. -/
noncomputable def blockVarBound {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (s : Δ.Symbol) : Nat :=
  (rep.block s).varBound

/-- Largest local variable used by any representation block in a finite source language. -/
noncomputable def maxBlockVar {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) : Nat :=
  (Finset.univ : Finset Δ.Symbol).sup fun s =>
    FiniteSupport.maxVar (rep.block s).constraints

/-- Conservative per-source-constraint auxiliary width for recursive block allocation. -/
noncomputable def auxBlockWidth {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) : Nat :=
  (Finset.univ : Finset Δ.Symbol).sup fun s => rep.blockVarBound s

/-- Maximum number of target constraints used by any representation block. -/
noncomputable def maxBlockConstraints {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) : Nat :=
  (Finset.univ : Finset Δ.Symbol).sup fun s => (rep.block s).constraints.length

theorem var_lt_blockVarBound {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (s : Δ.Symbol) {x : Nat}
    (hx : x ∈ FiniteSupport.formulaVars (rep.block s).constraints) :
    x < rep.blockVarBound s :=
  (rep.block s).var_lt_varBound hx

theorem blockVarBound_le_auxBlockWidth {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (s : Δ.Symbol) :
    rep.blockVarBound s ≤ rep.auxBlockWidth := by
  classical
  exact Finset.le_sup
    (s := (Finset.univ : Finset Δ.Symbol))
    (f := fun s => rep.blockVarBound s)
    (b := s)
    (Finset.mem_univ s)

theorem var_lt_auxBlockWidth {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (s : Δ.Symbol) {x : Nat}
    (hx : x ∈ FiniteSupport.formulaVars (rep.block s).constraints) :
    x < rep.auxBlockWidth :=
  lt_of_lt_of_le (rep.var_lt_blockVarBound s hx) (rep.blockVarBound_le_auxBlockWidth s)

/-- The block-width side condition discharged by `auxBlockWidth`. -/
theorem blockBound {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) :
    ∀ s : Δ.Symbol, ∀ c ∈ (rep.block s).constraints,
      ∀ i : Fin (Γ.relationOf c.symbol).arity, c.vars i < rep.auxBlockWidth := by
  intro s c hc i
  exact rep.var_lt_auxBlockWidth s (FiniteSupport.var_mem_formulaVars_of_constraint_mem hc i)

theorem block_constraints_length_le_maxBlockConstraints {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (s : Δ.Symbol) :
    (rep.block s).constraints.length ≤ rep.maxBlockConstraints := by
  classical
  exact Finset.le_sup
    (s := (Finset.univ : Finset Δ.Symbol))
    (f := fun s => (rep.block s).constraints.length)
    (b := s)
    (Finset.mem_univ s)

end LanguageRepresentation

/-- Formula-level expansion with automatically chosen source and block bounds. -/
noncomputable def formulaViaRepresentation {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (φ : Formula Δ) : Formula Γ :=
  formulaViaRepresentationFrom rep
    (FiniteSupport.formulaVarBound φ)
    rep.auxBlockWidth
    φ

/-- Satisfiability preservation for the automatically bounded expansion. -/
theorem formulaViaRepresentation_satisfiable_iff {D : Type} {Δ Γ : Language D}
    (rep : LanguageRepresentation Δ Γ) (φ : Formula Δ) :
    Formula.Satisfiable (formulaViaRepresentation rep φ) ↔ Formula.Satisfiable φ := by
  constructor
  · rintro ⟨a, h⟩
    exact ⟨a, formulaViaRepresentationFrom_sound rep
      (FiniteSupport.formulaVarBound φ) rep.auxBlockWidth φ a h⟩
  · rintro ⟨a, h⟩
    rcases formulaViaRepresentationFrom_complete rep
        (FiniteSupport.formulaVarBound φ) rep.auxBlockWidth φ a
        (FiniteSupport.sourceFresh_at_formulaVarBound φ)
        rep.blockBound
        h with ⟨b, _hbBase, hbSat⟩
    exact ⟨b, hbSat⟩

/-- Automatically bounded expansion for a one-symbol derived-language extension. -/
noncomputable def formulaViaSingleDerivedRepresentation {D : Type} [Inhabited D]
    (Γ : Language D) {arity : Nat} (block : RelationFormula Γ arity)
    (φ : Formula (singleDerivedLanguage Γ block)) : Formula Γ :=
  formulaViaRepresentation (singleDerivedRepresentation Γ block) φ

theorem formulaViaSingleDerivedRepresentation_satisfiable_iff {D : Type} [Inhabited D]
    (Γ : Language D) {arity : Nat} (block : RelationFormula Γ arity)
    (φ : Formula (singleDerivedLanguage Γ block)) :
    Formula.Satisfiable (formulaViaSingleDerivedRepresentation Γ block φ) ↔
      Formula.Satisfiable φ :=
  formulaViaRepresentation_satisfiable_iff (singleDerivedRepresentation Γ block) φ

/-- Automatically bounded expansion for a finite derived-family extension. -/
noncomputable def formulaViaDerivedFamilyRepresentation {D : Type} [Inhabited D]
    (Γ : Language D) {NewSym : Type} [Fintype NewSym]
    (arityOf : NewSym → Nat)
    (block : ∀ s : NewSym, RelationFormula Γ (arityOf s))
    (φ : Formula (derivedFamilyLanguage Γ arityOf block)) : Formula Γ :=
  formulaViaRepresentation (derivedFamilyRepresentation Γ arityOf block) φ

theorem formulaViaDerivedFamilyRepresentation_satisfiable_iff {D : Type} [Inhabited D]
    (Γ : Language D) {NewSym : Type} [Fintype NewSym]
    (arityOf : NewSym → Nat)
    (block : ∀ s : NewSym, RelationFormula Γ (arityOf s))
    (φ : Formula (derivedFamilyLanguage Γ arityOf block)) :
    Formula.Satisfiable (formulaViaDerivedFamilyRepresentation Γ arityOf block φ) ↔
      Formula.Satisfiable φ :=
  formulaViaRepresentation_satisfiable_iff (derivedFamilyRepresentation Γ arityOf block) φ

end PPDef
end FiniteDomain
end CSP
end ComplexityReduction
